# --- Database ---
POSTGRES_DB=conduit
POSTGRES_USER=conduit
POSTGRES_PASSWORD=conduit_password

# --- Backend ---
DB_ENGINE=django.db.backends.postgresql
DB_NAME=conduit
DB_USER=conduit
DB_PASSWORD=conduit_password
DB_HOST=database
DB_PORT=5432
DJANGO_DEBUG=1
ALLOWED_HOSTS=*
BACKEND_PORT=8281
CORS_ORIGIN_WHITELIST=http://localhost:8282,http://127.0.0.1:8282

# --- Frontend ---
API_URL=/api
FRONTEND_PORT=8282